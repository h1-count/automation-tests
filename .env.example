# 快速 Playwright 测试的默认环境。
DEFAULT_TEST_ENV=test
TEST_ENV=test
# 生产环境测试需用户点名并显式设置 ALLOW_PRODUCTION_TESTS=true，平时保持 false。
ALLOW_PRODUCTION_TESTS=false

# 环境地址目录。Runner 仅根据已确认的 TEST_ENV 读取对应地址。
OPEN_PLATFORM_WEB_BASE_URL_TEST=http://127.0.0.1:3098/
OPEN_PLATFORM_WEB_BASE_URL_PRE=https://open-platform-pre.ikingcity.com/
OPEN_PLATFORM_WEB_BASE_URL_PROD=https://open-platform.ikingcity.com/

# 本地调试覆盖（优先级最高，平时留空）。
FAST_BASE_URL=

# 登录/注册使用的固定测试凭据（test 环境专用合成值）。
TEST_PHONE=13000000000
TEST_PHONE_SECOND=13000000001
TEST_VERIFICATION_CODE=000000
