# 已确认的活动测试环境。执行前由用户确认的测试计划决定。
DEFAULT_TEST_ENV=test
TEST_ENV=test
ALLOW_PRODUCTION_TESTS=false

# 环境地址目录。Runner 仅根据已确认的 TEST_ENV 读取对应地址。
OPEN_PLATFORM_WEB_BASE_URL_TEST="https://open-platform-test.ikingcity.com/"
OPEN_PLATFORM_WEB_BASE_URL_PRE="https://open-platform-pre.ikingcity.com/"
OPEN_PLATFORM_WEB_BASE_URL_PROD="https://open-platform.ikingcity.com/"

# 已登录 Web 测试的本地会话文件。文件包含 Cookie/Storage，仅保存在本机且被 Git 忽略。
# 无法提供测试环境人机验证豁免时，先运行 auth:open-platform:initialize 完成人工一次登录，再复用该会话。
OPEN_PLATFORM_AUTH_STATE_PATH_TEST=.auth/open-platform-test.json
OPEN_PLATFORM_AUTH_STATE_PATH_PRE=.auth/open-platform-pre.json
OPEN_PLATFORM_AUTH_STATE_PATH_PROD=.auth/open-platform-prod.json

# 开放平台注册正式执行专用输入。仅 test 环境允许；手机号、固定测试码和会话值只写本机 .env 或 CI Secret。
# 未配置固定测试码时，脚本在可见浏览器等待人工完成安全挑战并输入短信验证码，随后自动继续。
OPEN_PLATFORM_REGISTRATION_PHONE_TEST=
OPEN_PLATFORM_REGISTRATION_FIXED_OTP_TEST=
OPEN_PLATFORM_REGISTRATION_AUTH_STATE_PATH_TEST=.auth/open-platform-registration-test.json

OPEN_PLATFORM_ADMIN_LOGIN_URL_TEST="https://portal-test.ikingcity.com/login?plat=aiot-open-platform&ltype=1&redirect=https%3A%2F%2Fopen-platform-admin-test.ikingcity.com%2Ftemplate-management%2Fproduct-template"
OPEN_PLATFORM_ADMIN_LOGIN_URL_PRE="https://portal-pre.ikingcity.com/login?plat=aiot-open-platform&ltype=1&redirect=https%3A%2F%2Fopen-platform-admin-pre.ikingcity.com%2Ftemplate-management%2Fproduct-template"
OPEN_PLATFORM_ADMIN_LOGIN_URL_PROD="https://portal-prod.ikingcity.com/login?plat=aiot-open-platform&ltype=1&redirect=https%3A%2F%2Fopen-platform-admin.ikingcity.com%2Ftemplate-management%2Fproduct-template"

CENTRAL_ADMIN_LOGIN_URL_TEST="https://portal-test.ikingcity.com/login?plat=aiot-operation&ltype=1&redirect=https%3A%2F%2Fadmin-test.ikingcity.com%2Fproduct-management%2Fproduct%2Finquiry%3Fr%3D1768448736451"
CENTRAL_ADMIN_LOGIN_URL_PRE="https://portal-pre.ikingcity.com/login?plat=aiot-operation&ltype=1&redirect=https%3A%2F%2Fadmin-pre.ikingcity.com%2Fproduct-management%2Fproduct%2Finquiry%3Fr%3D1768448736451"
CENTRAL_ADMIN_LOGIN_URL_PROD="https://portal-prod.ikingcity.com/login?plat=aiot-operation&ltype=1&redirect=https%3A%2F%2Fadmin.ikingcity.com%2Fproduct-management%2Fproduct%2Finquiry%3Fr%3D1768448736451"

# API 和 MQTT 地址暂未提供。配置真实值后才可执行 API、MQTT 或 IoT 链路测试。
OPEN_PLATFORM_API_BASE_URL_TEST=
OPEN_PLATFORM_API_BASE_URL_PRE=
OPEN_PLATFORM_API_BASE_URL_PROD=
MQTT_BROKER_URL_TEST=
MQTT_BROKER_URL_PRE=
MQTT_BROKER_URL_PROD=

# 测试身份按“系统 + 角色 + 环境”命名。仅填写专用测试身份；不要在此文件中填写真实密码、Token 或密钥。
# 开放平台：产品管理员，用于产品创建、编辑、查询等管理操作。
OPEN_PLATFORM_PRODUCT_ADMIN_USERNAME_TEST=
OPEN_PLATFORM_PRODUCT_ADMIN_PASSWORD_TEST=
OPEN_PLATFORM_PRODUCT_ADMIN_USERNAME_PRE=
OPEN_PLATFORM_PRODUCT_ADMIN_PASSWORD_PRE=
OPEN_PLATFORM_PRODUCT_ADMIN_USERNAME_PROD=
OPEN_PLATFORM_PRODUCT_ADMIN_PASSWORD_PROD=

# 集中管理后台：运营管理员，用于集中后台运营与产品管理场景。
CENTRAL_ADMIN_OPERATOR_USERNAME_TEST=
CENTRAL_ADMIN_OPERATOR_PASSWORD_TEST=
CENTRAL_ADMIN_OPERATOR_USERNAME_PRE=
CENTRAL_ADMIN_OPERATOR_PASSWORD_PRE=
CENTRAL_ADMIN_OPERATOR_USERNAME_PROD=
CENTRAL_ADMIN_OPERATOR_PASSWORD_PROD=

# 移动 App：普通测试用户，用于原生 App 和 WebView 场景。
MOBILE_APP_USER_USERNAME_TEST=
MOBILE_APP_USER_PASSWORD_TEST=
MOBILE_APP_USER_USERNAME_PRE=
MOBILE_APP_USER_PASSWORD_PRE=
MOBILE_APP_USER_USERNAME_PROD=
MOBILE_APP_USER_PASSWORD_PROD=

# API：独立 Token 或 Client 凭据，不能复用页面登录密码。
OPEN_PLATFORM_API_TOKEN_TEST=
OPEN_PLATFORM_API_TOKEN_PRE=
OPEN_PLATFORM_API_TOKEN_PROD=

# MQTT：测试客户端或设备的连接凭据。
MQTT_USERNAME_TEST=
MQTT_PASSWORD_TEST=
MQTT_USERNAME_PRE=
MQTT_PASSWORD_PRE=
MQTT_USERNAME_PROD=
MQTT_PASSWORD_PROD=

# Appium 使用外部启动的 Appium Server。设备、App 包和账号均应与已确认的测试计划一致。
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_PLATFORM_NAME=Android
APPIUM_AUTOMATION_NAME=UiAutomator2
APPIUM_DEVICE_NAME=
APPIUM_UDID=

# App 启动方式二选一：
# 方式一：填写 APK 或 IPA 的绝对路径，Appium 会安装后再执行测试。
APPIUM_APP_PATH=

# 方式二：测试设备已安装 App 时，填写包名和启动 Activity；两项必须同时填写。
APPIUM_APP_PACKAGE=
APPIUM_APP_ACTIVITY=
