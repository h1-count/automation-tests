{
  "description": "Optional Harness lifecycle adapter from a host Stop event to the request workflow gate.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/harness-stop-stage-envelope.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking workflow reply eligibility"
          }
        ]
      }
    ]
  }
}
