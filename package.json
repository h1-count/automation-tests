{
  "name": "iot-automation-tests",
  "version": "0.1.0",
  "private": true,
  "description": "IoT 自动化测试工程：快速 Playwright 通道。",
  "type": "module",
  "engines": {
    "node": ">=20.19 <25"
  },
  "scripts": {
    "test": "npm run test:fast",
    "test:fast": "node scripts/run-fast-tests.mjs",
    "test:fast:headed": "node scripts/run-fast-tests.mjs --headed",
    "report": "playwright show-report",
    "sources:ingest": "node scripts/source-library.mjs ingest",
    "check:types": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
