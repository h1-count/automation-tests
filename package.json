{
  "name": "iot-automation-tests",
  "version": "0.1.0",
  "private": true,
  "description": "IoT 自动化测试工程，覆盖开放平台 Web、App、API、MQTT 和端到端链路。",
  "type": "module",
  "engines": {
    "node": ">=20.19 <25"
  },
  "scripts": {
    "test": "npm run test:fast",
    "test:fast": "playwright test --config=playwright.fast.config.ts",
    "test:fast:headed": "playwright test --config=playwright.fast.config.ts --headed",
    "test:web": "playwright test",
    "test:web:execute": "tsx scripts/run-formal-web-tests.ts",
    "test:execute": "tsx scripts/run-formal-tests.ts",
    "test:web:verify-selectors": "tsx scripts/verify-web-selectors.ts",
    "test:web:explore": "playwright test --config=playwright.debug.config.ts",
    "browser:exploration:setup": "tsx scripts/manage-browser-exploration.ts setup",
    "browser:exploration:status": "tsx scripts/manage-browser-exploration.ts status",
    "browser:exploration:remove": "tsx scripts/manage-browser-exploration.ts remove",
    "check:web-exploration": "tsx scripts/check-web-exploration.ts",
    "test:suite:assess": "tsx scripts/manage-test-suite.ts assess",
    "test:suite:status": "tsx scripts/manage-test-suite.ts status",
    "test:suite:register-design": "tsx scripts/manage-test-suite.ts register-design",
    "test:suite:refresh-design": "tsx scripts/manage-test-suite.ts refresh-design",
    "test:web:chrome": "playwright test --config=playwright.chrome.config.ts",
    "test:web:authenticated": "playwright test --config=playwright.authenticated.config.ts",
    "test:web:debug": "playwright test --config=playwright.debug.config.ts --debug=inspector",
    "test:web:inspect": "playwright test --config=playwright.debug.config.ts --debug=inspector",
    "auth:open-platform:initialize": "tsx scripts/capture-open-platform-auth-state.ts",
    "test:api": "playwright test tests/api",
    "test:iot-chain": "playwright test tests/iot-chain",
    "test:app": "wdio run wdio.conf.ts",
    "check:architecture": "tsx scripts/check-test-architecture.ts",
    "check:rule-design": "tsx scripts/rule-design-preflight.ts",
    "check:markdown": "tsx scripts/check-markdown-format.ts",
    "check:knowledge-index": "tsx scripts/check-knowledge-index.ts",
    "sources:ingest": "tsx scripts/manage-sources-ingest.ts",
    "test:sources-ingest": "tsx --test tests/support/sources-ingest/*.test.ts",
    "knowledge:search": "tsx scripts/search-knowledge.ts",
    "knowledge:manage": "tsx scripts/manage-project-knowledge.ts",
    "check:test-assets": "tsx scripts/check-test-assets.ts",
    "test-assets:select": "tsx scripts/select-test-asset.ts",
    "test-assets:prepare-registration-upload": "tsx scripts/prepare-open-platform-registration-upload-assets.ts",
    "test:asset-selection": "tsx --test tests/support/test-assets/*.test.ts",
    "check:environment": "tsx scripts/check-environment.ts",
    "check:types": "tsc --project tsconfig.json",
    "check:firmware:test": "tsx scripts/check-firmware-test-prerequisites.ts",
    "test:test-data": "tsx --test tests/support/test-data/*.test.ts",
    "test:automation-runtime": "tsx --test tests/support/web/*.test.ts",
    "test:formal-execution": "tsx --test tests/support/formal-execution/*.test.ts",
    "test:test-suite": "tsx --test tests/support/test-suite/*.test.ts",
    "test-data:recover": "tsx src/support/test-data/recover.ts",
    "test:task-workflow": "tsx --test tests/support/task-workflow/v1-baseline.test.ts tests/support/task-workflow/design-reconfirm-branch.test.ts tests/support/task-workflow/candidate-compiler.test.ts tests/support/task-workflow/candidate-preflight.test.ts",
    "test:maintenance": "tsx --test tests/support/reset-full-test-state-rules.test.ts",
    "test:rule-design": "tsx --test tests/support/rule-design-preflight.test.ts",
    "test:testcase-quality": "tsx --test tests/support/testcase-quality-gate.test.ts tests/support/knowledge-decision.test.ts tests/support/markdown-format.test.ts tests/support/stage-run-envelope-rules.test.ts",
    "test:project-knowledge": "tsx --test tests/support/project-knowledge-candidates.test.ts",
    "test:testcase-relations": "tsx --test tests/support/testcase-relation-projections.test.ts tests/support/testcase-document-v1-layered.test.ts tests/support/testcase-review-workbook.test.ts tests/support/testcase-review-reading-map.test.ts tests/support/testcase-requirement-facts.test.ts",
    "testcases:sync-relations": "tsx scripts/sync-testcase-relations.ts",
    "testcases:revision-tier": "tsx scripts/check-revision-tier.ts",
    "task:status": "tsx src/support/task-workflow/cli/status.ts",
    "task:initialize": "tsx src/support/task-workflow/cli/manage.ts init",
    "task:resume": "tsx src/support/task-workflow/cli/manage.ts resume",
    "task:gate": "tsx src/support/task-workflow/cli/gate.ts",
    "task:manage": "tsx src/support/task-workflow/cli/manage.ts",
    "cleanup:local-runs": "tsx scripts/cleanup-local-runs.ts",
    "cleanup:review-cache": "tsx scripts/cleanup-review-workbook-cache.ts",
    "reset:full-test-state": "tsx scripts/reset-full-test-state.ts",
    "report:playwright": "playwright show-report artifacts/playwright-report",
    "report:allure": "allure generate artifacts/allure-results --clean -o artifacts/allure-report",
    "report": "npm run report:playwright",
    "testcases:reproject": "tsx scripts/reproject-testcases.ts",
    "cost:analyze": "tsx scripts/analyze-request-cost.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@wdio/allure-reporter": "^9.29.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.2",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "webdriverio": "^9.29.1",
    "yaml": "^2.9.0"
  }
}
